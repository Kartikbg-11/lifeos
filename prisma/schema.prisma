// LIFEOS - Personal Growth & Daily Tracker Database Schema
// SQLite compatible version

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==================== USER & AUTH ====================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String?
  
  // Settings
  workoutGoal        Int      @default(60)       // minutes per day
  pushupGoal         Int      @default(60)       // push-ups per day
  learningGoal       Int      @default(180)      // minutes per day (3 hours)
  interviewGoal      Int      @default(180)      // minutes per day (3 hours)
  sleepGoal          Int      @default(480)      // minutes per day (8 hours)
  waterGoal          Int      @default(3000)     // ml per day (3 liters)
  proteinGoal        Int      @default(100)      // grams per day
  currency           String   @default("₹")
  timezone           String   @default("Asia/Kolkata")
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relations
  dailyEntries     DailyEntry[]
  fitnessEntries   FitnessEntry[]
  learningSessions LearningSession[]
  interviewSessions InterviewSession[]
  sleepEntries     SleepEntry[]
  foodEntries      FoodEntry[]
  waterEntries     WaterEntry[]
  expenseEntries   ExpenseEntry[]
  habits           Habit[]
  habitCompletions HabitCompletion[]
  goals            Goal[]
  journalEntries   JournalEntry[]
  reminders        Reminder[]
}

// ==================== DAILY ENTRY ====================

model DailyEntry {
  id          String   @id @default(cuid())
  userId      String
  date        String   // ISO date string YYYY-MM-DD
  overallNote String?
  mood        String?  // excellent, good, average, poor
  dailyScore  Int?     // 0-100 calculated score
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@unique([userId, date])
}

// ==================== FITNESS TRACKER ====================

model FitnessEntry {
  id              String   @id @default(cuid())
  userId          String
  date            String   // ISO date string YYYY-MM-DD
  workoutDuration Int?     // minutes
  workoutType     String?  // cardio, strength, hiit, yoga, sports, other
  pushups         Int      @default(0)
  squats          Int      @default(0)
  pullups         Int      @default(0)
  otherExercises  String?
  caloriesBurned  Int?
  completed       Boolean  @default(false)
  notes           String?
  
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([userId, date])
}

// ==================== LEARNING TRACKER ====================

model LearningSession {
  id              String   @id @default(cuid())
  userId          String
  date            String   // ISO date string YYYY-MM-DD
  topic           String
  category        String?  // api-testing, python, ai-testing, sql, automation, other
  startTime       String?  // ISO datetime
  endTime         String?  // ISO datetime
  duration        Int?     // minutes (auto-calculated)
  whatLearned     String?
  notes           String?
  completed       Boolean  @default(false)
  
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([userId, date])
}

// ==================== INTERVIEW PREPARATION ====================

model InterviewSession {
  id                  String   @id @default(cuid())
  userId              String
  date                String   // ISO date string YYYY-MM-DD
  topic               String
  category            String?  // manual-testing, automation, api-testing, sql, java, python, ai-testing, llm-testing, rag-testing, selenium, testng, postman, performance, security, hr, behavioral, coding, aptitude, other
  startTime           String?  // ISO datetime
  endTime             String?  // ISO datetime
  duration            Int?     // minutes (auto-calculated)
  questionsPracticed  Int      @default(0)
  questionsAnswered   Int      @default(0)
  correctAnswers      Int      @default(0)
  incorrectAnswers    Int      @default(0)
  mockInterview       Boolean  @default(false)
  codingPractice      Boolean  @default(false)
  notes               String?
  confidenceLevel     Int?     // 1-5
  difficulty          String?  // easy, medium, hard
  
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([userId, date])
}

// ==================== SLEEP TRACKER ====================

model SleepEntry {
  id           String   @id @default(cuid())
  userId       String
  date         String   // ISO date string YYYY-MM-DD (date of going to sleep)
  sleepStart   String   // ISO datetime
  sleepEnd     String   // ISO datetime
  totalMinutes Int?    // auto-calculated
  quality      String?  // excellent, good, fair, poor
  notes        String?
  
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([userId, date])
}

// ==================== FOOD TRACKER ====================

model FoodEntry {
  id            String   @id @default(cuid())
  userId        String
  date          String   // ISO date string YYYY-MM-DD
  mealType      String   // breakfast, lunch, dinner, snack, pre-workout, post-workout
  foodName      String
  quantity      String?
  calories      Int?
  protein       Int?     // grams
  carbohydrates Int?     // grams
  fat           Int?     // grams
  notes         String?
  
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([userId, date])
}

// ==================== WATER TRACKER ====================

model WaterEntry {
  id        String   @id @default(cuid())
  userId    String
  date      String   // ISO date string YYYY-MM-DD
  amount    Int      // ml
  notes     String?
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([userId, date])
}

// ==================== EXPENSE TRACKER ====================

model ExpenseEntry {
  id            String   @id @default(cuid())
  userId        String
  date          String   // ISO date string YYYY-MM-DD
  amount        Float
  category      String   // food, travel, shopping, gym, education, entertainment, bills, health, other
  reason        String?
  paymentMethod String?  // cash, upi, card, bank-transfer, other
  notes         String?
  
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([userId, date])
}

// ==================== HABIT TRACKER ====================

model Habit {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  icon        String?  // emoji or icon name
  color       String?  // hex color
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  completions HabitCompletion[]
}

model HabitCompletion {
  id        String   @id @default(cuid())
  habitId   String
  userId    String
  date      String   // ISO date string YYYY-MM-DD
  completed Boolean  @default(true)
  
  habit     Habit     @relation(fields: [habitId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  
  @@unique([habitId, userId, date])
  @@index([userId, date])
}

// ==================== GOALS ====================

model Goal {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  type        String   // daily, weekly, monthly
  category    String   // fitness, learning, interview, sleep, water, protein, expense, other
  targetValue Int?
  unit        String?  // minutes, reps, ml, grams, etc.
  startDate   String   // ISO date string YYYY-MM-DD
  endDate     String?  // ISO date string YYYY-MM-DD
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ==================== JOURNAL ====================

model JournalEntry {
  id                  String   @id @default(cuid())
  userId              String
  date                String   // ISO date string YYYY-MM-DD
  accomplishments     String?
  whatLearned         String?
  wentWell            String?
  wentWrong           String?
  improvementTomorrow  String?
  generalNotes        String?
  
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@unique([userId, date])
}

// ==================== REMINDERS ====================

model Reminder {
  id        String   @id @default(cuid())
  userId    String
  title     String
  type      String   // gym, learning, interview, water, sleep, custom
  time      String   // HH:mm format
  days      String   // comma-separated: mon,tue,wed,thu,fri,sat,sun
  isEnabled Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

        { "name": "Create habit", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Read 20 pages\",\n  \"description\": \"Daily reading\",\n  \"icon\": \"book\",\n  \"color\": \"#6366f1\",\n  \"isActive\": true\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/habits" } },
        { "name": "Update habit", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Read 30 pages\",\n  \"isActive\": true\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/habits/{{habitId}}" } },
        { "name": "Delete habit", "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/habits/{{habitId}}" } },
        { "name": "Set habit completion", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"habitId\": \"{{habitId}}\",\n  \"date\": \"{{date}}\",\n  \"completed\": true\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/habits/complete" } },

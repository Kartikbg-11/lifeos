        { "name": "Update expense", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"amount\": 275,\n  \"reason\": \"Lunch and tea\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/expenses/{{resourceId}}" } },

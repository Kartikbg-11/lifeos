{
  "info": {
    "_postman_id": "c295cc2d-e1b6-41a5-a16c-72b01530a376",
    "name": "LIFEOS API",
    "description": "LIFEOS API collection. Run Register or Login first; Postman retains the HTTP-only session cookie automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8090/api", "type": "string" },
    { "key": "resourceId", "value": "replace-with-resource-id", "type": "string" },
    { "key": "habitId", "value": "replace-with-habit-id", "type": "string" },
    { "key": "date", "value": "2026-09-01", "type": "string" },
    { "key": "month", "value": "2026-09", "type": "string" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        { "name": "API health", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}" } }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        { "name": "Register", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Demo User\",\n  \"email\": \"demo@example.com\",\n  \"password\": \"secret123\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/auth/register" } },
        { "name": "Login", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"demo@example.com\",\n  \"password\": \"secret123\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/auth/login" } },
        { "name": "Current user", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/auth/me" } },
        { "name": "Logout", "request": { "method": "POST", "header": [], "url": "{{baseUrl}}/auth/logout" } }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        { "name": "Today", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/dashboard/today" } },
        { "name": "Daily score", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/dashboard/score?date={{date}}" } },
        { "name": "Weekly", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/dashboard/weekly" } },
        { "name": "Monthly", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/dashboard/monthly?month={{month}}" } }
      ]
    },
    {
      "name": "Fitness",
      "item": [
        { "name": "List fitness", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/fitness?startDate={{date}}&endDate={{date}}&limit=50" } },
        { "name": "Create fitness", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"date\": \"{{date}}\",\n  \"workoutType\": \"strength\",\n  \"workoutDuration\": 60,\n  \"pushups\": 40,\n  \"squats\": 40,\n  \"completed\": true,\n  \"notes\": \"Morning session\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/fitness" } },
        { "name": "Update fitness", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"workoutDuration\": 75,\n  \"completed\": true\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/fitness/{{resourceId}}" } },
        { "name": "Delete fitness", "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/fitness/{{resourceId}}" } }
      ]
    },
